# Database Configuration
DATABASE_URL=postgresql://postgres:password@db:5432/zopio_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=zopio_dev

# Node Environment
NODE_ENV=development

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002

# File Watching (for macOS Docker development)
CHOKIDAR_USEPOLLING=1
WATCHPACK_POLLING=true

# Clerk Authentication (if using Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Stripe (if using Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog Analytics (if using PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (if using Sentry)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# BaseHub CMS (if using BaseHub)
# BASEHUB_TOKEN=

# Trigger.dev (if using Trigger)
# TRIGGER_API_KEY=
# TRIGGER_API_URL=

# Optional: Turborepo Remote Cache
# TURBO_TEAM=
# TURBO_TOKEN=