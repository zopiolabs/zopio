# Database Configuration
# IMPORTANT: Change POSTGRES_PASSWORD to a strong, unique password
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_BEFORE_PRODUCTION
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/zopio
POSTGRES_USER=postgres
POSTGRES_DB=zopio

# Node Environment
NODE_ENV=production

# Application URLs (Update with your production domains)
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
NEXT_PUBLIC_WEB_URL=https://www.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Clerk Authentication (Required for production)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Stripe Payments (if using Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog Analytics (if using PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (Recommended for production)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_ENVIRONMENT=production

# BaseHub CMS (if using BaseHub)
# BASEHUB_TOKEN=

# Trigger.dev (if using Trigger)
# TRIGGER_API_KEY=
# TRIGGER_API_URL=

# Security Headers
# ARCJET_KEY=

# Turborepo Remote Cache (Optional for CI/CD)
# TURBO_TEAM=
# TURBO_TOKEN=

# Logging and Monitoring
# LOG_LEVEL=info
# ENABLE_OPENTELEMETRY=true

# Redis Configuration (if using Redis in production)
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=

# Email Configuration (production SMTP)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# Session Configuration
# SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS

# JWT Configuration
# JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
# JWT_EXPIRATION=7d