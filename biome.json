{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "javascript": {
    "globals": ["Liveblocks"]
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/*.d.ts",
      "!!**/__tests__",
      "!!**/.bin",
      "!!**/.cache",
      "!!**/.git",
      "!!**/.next",
      "!!**/.turbo",
      "!!apps/docs/**/*.json",
      "!!devapps/emailstudio/.react-email",
      "!!devapps/storybook/storybook-static",
      "!!**/build",
      "!!**/dist",
      "!!**/node_modules",
      "!!packages/collaboration/config.ts",
      "!!packages/database/generated",
      "!!packages/design-system/blocks",
      "!!packages/design-system/hooks",
      "!!packages/design-system/lib",
      "!!packages/design-system/shared",
      "!!packages/design-system/ui",
      "!!scripts",
      "!!websites/zopio-docs/**/*.json",
      "!!websites/zopio-docs/snippets"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noLeakedRender": "off",
        "noShadow": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "style": {
        "useConsistentTypeDefinitions": "off"
      }
    }
  }
}
