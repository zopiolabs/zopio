    "validate": "node dist/validate-scenario.js"
  },
  "dependencies": {
    "@repo/mcp": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.0.13",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
