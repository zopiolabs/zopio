  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"],
      "@repo/design-system": ["../../packages/design-system"],
      "@repo/design-system/*": ["../../packages/design-system/*"],
      "@repo/design-system/ui": ["../../packages/design-system/ui"],
